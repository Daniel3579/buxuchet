        <mxCell id="OramX9K1tMWRZQ_M8pk5-45" parent="OramX9K1tMWRZQ_M8pk5-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=23;" value="Сценарий 2 — Просмотр подготовленных форм РСБУ" vertex="1">
          <mxGeometry height="80" width="360" x="440" y="400" as="geometry" />
        </mxCell>
        <mxCell id="OramX9K1tMWRZQ_M8pk5-46" parent="OramX9K1tMWRZQ_M8pk5-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-1&lt;/h1&gt;&lt;p&gt;Для бухгалтерской отчётности используются только проведённые учётные данные; черновики документов и непроведённые операции в расчёт не&lt;br/&gt;включаются.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="450" y="240" as="geometry" />
        </mxCell>
        <mxCell id="OramX9K1tMWRZQ_M8pk5-47" edge="1" parent="OramX9K1tMWRZQ_M8pk5-1" source="OramX9K1tMWRZQ_M8pk5-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="OramX9K1tMWRZQ_M8pk5-48" value="">
