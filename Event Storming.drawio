        <mxCell id="OramX9K1tMWRZQ_M8pk5-44" parent="OramX9K1tMWRZQ_M8pk5-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-3" vertex="1">
