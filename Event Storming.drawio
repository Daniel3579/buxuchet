        </mxCell>
        <mxCell id="vdcdDyUptPlhzMoAqBFv-76" parent="vdcdDyUptPlhzMoAqBFv-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-6&lt;/h1&gt;&lt;p&gt;Проведённый документ нельзя редактировать напрямую. Исправление выполняется сторно в открытом периоде.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="1410" y="650" as="geometry" />
        </mxCell>
        <mxCell id="vdcdDyUptPlhzMoAqBFv-77" parent="vdcdDyUptPlhzMoAqBFv-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-5" vertex="1">
