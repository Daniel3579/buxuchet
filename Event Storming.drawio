        <mxCell id="7_LdBWUnG--kd9-BXZT3-72" parent="7_LdBWUnG--kd9-BXZT3-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" value="&lt;div&gt;Документ сторнирован&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="120" x="1980" y="570" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-73" parent="7_LdBWUnG--kd9-BXZT3-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=23;" value="Сценарий 2 — Исправление проведённого документа" vertex="1">
          <mxGeometry height="80" width="360" x="1410" y="450" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-74" parent="7_LdBWUnG--kd9-BXZT3-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-4&lt;/h1&gt;&lt;p&gt;При проведении должен соблюдаться принцип двойной записи: сумма дебетовых оборотов равна сумме кредитовых.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="1420" y="255" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-75" parent="7_LdBWUnG--kd9-BXZT3-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-6" vertex="1">
          <mxGeometry height="50" width="120" x="2140" y="570" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-76" parent="7_LdBWUnG--kd9-BXZT3-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-6&lt;/h1&gt;&lt;p&gt;Проведённый документ нельзя редактировать напрямую. Исправление выполняется сторно в открытом периоде.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="1410" y="650" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-77" parent="7_LdBWUnG--kd9-BXZT3-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-5" vertex="1">
          <mxGeometry height="50" width="120" x="2140" y="260" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-78" parent="7_LdBWUnG--kd9-BXZT3-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-5&lt;/h1&gt;&lt;p&gt;Проводить документ можно только в открытом учётном периоде. При закрытом периоде команда отклоняется&lt;/p&gt;" vertex="1">
