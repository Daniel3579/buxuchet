        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-45" parent="7_LdBWUnG--kd9-BXZT3-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=23;" value="Сценарий 2 — Загрузка банковской выписки" vertex="1">
          <mxGeometry height="80" width="360" x="440" y="400" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-46" parent="7_LdBWUnG--kd9-BXZT3-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-1&lt;/h1&gt;&lt;p&gt;При добавлении проводки учётный документ проверяет допустимость корреспонденции счетов. При ошибке команда отклоняется; событие&lt;br/&gt;«Проводка добавлена» не возникает.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="450" y="240" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-47" edge="1" parent="7_LdBWUnG--kd9-BXZT3-1" source="7_LdBWUnG--kd9-BXZT3-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="7_LdBWUnG--kd9-BXZT3-48" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="965" y="645" as="sourcePoint" />
            <mxPoint x="1170" y="645" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-48" parent="7_LdBWUnG--kd9-BXZT3-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" value="&lt;div&gt;Проводки сформированы&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="120" x="1010" y="620" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-49" parent="7_LdBWUnG--kd9-BXZT3-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-2" vertex="1">
          <mxGeometry height="50" width="120" x="1170" y="520" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-50" parent="7_LdBWUnG--kd9-BXZT3-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-2&lt;/h1&gt;&lt;p&gt;При загрузке проверяются формат и целостность файла. При ошибке файл отклоняется целиком; повторная загрузка идентичного файла&lt;br/&gt;блокируется по хешу.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="440" y="700" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-51" parent="7_LdBWUnG--kd9-BXZT3-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-3&lt;/h1&gt;&lt;p&gt;Автоматически формируемые проводки должны проходить проверку корреспонденции счетов. При ошибке успешное событие о формировании не&lt;br/&gt;возникает&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="790" y="700" as="geometry" />
        </mxCell>
        <mxCell id="7_LdBWUnG--kd9-BXZT3-52" parent="7_LdBWUnG--kd9-BXZT3-1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;" value="" vertex="1">
