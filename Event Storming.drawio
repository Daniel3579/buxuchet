        <mxCell id="vdcdDyUptPlhzMoAqBFv-78" parent="vdcdDyUptPlhzMoAqBFv-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-5&lt;/h1&gt;&lt;p&gt;Проводить документ можно только в открытом учётном периоде. При закрытом периоде команда отклоняется&lt;/p&gt;" vertex="1">
