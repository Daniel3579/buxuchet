        </mxCell>
        <mxCell id="Xh7_BeMGdFSyxhsYVvos-44" parent="Xh7_BeMGdFSyxhsYVvos-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-10" vertex="1">
          <mxGeometry height="50" width="120" x="1010" y="620" as="geometry" />
        </mxCell>
        <mxCell id="Xh7_BeMGdFSyxhsYVvos-45" parent="Xh7_BeMGdFSyxhsYVvos-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=23;" value="Сценарий 2 — Учёт материалов по нормам" vertex="1">
          <mxGeometry height="80" width="360" x="440" y="400" as="geometry" />
        </mxCell>
        <mxCell id="Xh7_BeMGdFSyxhsYVvos-46" parent="Xh7_BeMGdFSyxhsYVvos-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-8&lt;/h1&gt;&lt;p&gt;Для одной записи затрат выбирается один объект учёта: заказ, продукт или цех. Сумма должна быть положительной; одну и ту же затрату нельзя&lt;br/&gt;учитывать дважды.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="440" y="150" as="geometry" />
        </mxCell>
        <mxCell id="Xh7_BeMGdFSyxhsYVvos-47" edge="1" parent="Xh7_BeMGdFSyxhsYVvos-1" source="Xh7_BeMGdFSyxhsYVvos-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="Xh7_BeMGdFSyxhsYVvos-48" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="965" y="645" as="sourcePoint" />
            <mxPoint x="1170" y="645" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Xh7_BeMGdFSyxhsYVvos-48" parent="Xh7_BeMGdFSyxhsYVvos-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" value="Материальные затраты учтены&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="120" x="830" y="620" as="geometry" />
        </mxCell>
        <mxCell id="Xh7_BeMGdFSyxhsYVvos-49" parent="Xh7_BeMGdFSyxhsYVvos-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-9" vertex="1">
          <mxGeometry height="50" width="120" x="1170" y="520" as="geometry" />
        </mxCell>
        <mxCell id="Xh7_BeMGdFSyxhsYVvos-50" parent="Xh7_BeMGdFSyxhsYVvos-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-9&lt;/h1&gt;&lt;p&gt;Для каждой пары «продукт — материал» хранится одна действующая норма расхода. Значение нормы должно быть положительным.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="440" y="700" as="geometry" />
        </mxCell>
        <mxCell id="Xh7_BeMGdFSyxhsYVvos-51" parent="Xh7_BeMGdFSyxhsYVvos-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-10&lt;/h1&gt;&lt;p&gt;Для расчёта указываются объём продукции и учётная цена материала. Нормативная сумма = норма на единицу × объём × цена. Без действующей&lt;br&gt;нормы расчёт не выполняется.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="790" y="700" as="geometry" />
        </mxCell>
