        <mxCell id="7_LdBWUnG--kd9-BXZT3-44" parent="7_LdBWUnG--kd9-BXZT3-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-3" vertex="1">
