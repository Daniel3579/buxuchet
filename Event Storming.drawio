          </mxGeometry>
        </mxCell>
        <mxCell id="OramX9K1tMWRZQ_M8pk5-48" parent="OramX9K1tMWRZQ_M8pk5-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" value="&lt;div&gt;Проводки сформированы&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="120" x="1010" y="620" as="geometry" />
        </mxCell>
        <mxCell id="OramX9K1tMWRZQ_M8pk5-49" parent="OramX9K1tMWRZQ_M8pk5-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-2" vertex="1">
          <mxGeometry height="50" width="120" x="1170" y="520" as="geometry" />
        </mxCell>
        <mxCell id="OramX9K1tMWRZQ_M8pk5-50" parent="OramX9K1tMWRZQ_M8pk5-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-2&lt;/h1&gt;&lt;p&gt;При загрузке проверяются формат и целостность файла. При ошибке файл отклоняется целиком; повторная загрузка идентичного файла&lt;br/&gt;блокируется по хешу.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="440" y="700" as="geometry" />
        </mxCell>
        <mxCell id="OramX9K1tMWRZQ_M8pk5-51" parent="OramX9K1tMWRZQ_M8pk5-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-3&lt;/h1&gt;&lt;p&gt;Автоматически формируемые проводки должны проходить проверку корреспонденции счетов. При ошибке успешное событие о формировании не&lt;br/&gt;возникает&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="790" y="700" as="geometry" />
        </mxCell>
        <mxCell id="OramX9K1tMWRZQ_M8pk5-79" parent="OramX9K1tMWRZQ_M8pk5-1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;" value="" vertex="1">
