        <mxCell id="8foCAFPLKYiK_42LyMsu-92" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-4&lt;/h1&gt;&lt;p&gt;При проведении должен соблюдаться принцип двойной записи: сумма дебетовых оборотов равна сумме кредитовых.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="1420" y="255" as="geometry" />
        </mxCell>
        <mxCell id="8foCAFPLKYiK_42LyMsu-95" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-6" vertex="1">
