        <mxCell id="vdcdDyUptPlhzMoAqBFv-45" parent="vdcdDyUptPlhzMoAqBFv-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=23;" value="Сценарий 2 — Загрузка банковской выписки" vertex="1">
