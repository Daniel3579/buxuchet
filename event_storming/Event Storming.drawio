        <mxCell id="Xh7_BeMGdFSyxhsYVvos-97" parent="Xh7_BeMGdFSyxhsYVvos-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;БП-11&lt;/h1&gt;&lt;p&gt;В MVP для категории косвенных расходов выбирается одна база из двух вариантов: сумма прямых затрат или сумма материальных затрат.&lt;br/&gt;Сохранение настройки не запускает распределение. &lt;/p&gt;" vertex="1">
