        <mxCell id="8foCAFPLKYiK_42LyMsu-47" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=23;" value="Сценарий 2 — Загрузка банковской выписки" vertex="1">
