        <mxCell id="OramX9K1tMWRZQ_M8pk5-85" parent="OramX9K1tMWRZQ_M8pk5-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=23;" value="Просмотр подготовленных форм РСБУ" vertex="1">
