        <mxCell id="8foCAFPLKYiK_42LyMsu-98" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=light-dark(#D80073,#B266FF);fontColor=#ffffff;strokeColor=#A50040;gradientColor=none;" value="БП-5" vertex="1">
