        <mxCell id="OramX9K1tMWRZQ_M8pk5-84" parent="OramX9K1tMWRZQ_M8pk5-1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" value="Бухгалтерский баланс / ОФР / ОДДС" vertex="1">
